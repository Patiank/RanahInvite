rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Ranah Invite Studio — Ultra-Frugal Thin RSVP System
//
// This security rules file assumes the following data structure:
//
// Collection: events/{eventId}/rsvps
// Parent Path Param:
//   - eventId: string (required, 1..80 chars) - Event identifier
// Document ID: {invitationCode}
//   - invitationCode: string (required, 1..40 chars) - Unique invitation code
// Fields (strictly required, exact keys only; no guest PII stored):
//   - invitationCode: string (required, immutable, 1..40 chars, must equal {invitationCode} doc ID)
//   - status: string (required, enum: 'attending' | 'represented' | 'declined')
//   - representative: string (required, 0..120 chars; empty string when not represented)
//   - note: string (required, 0..240 chars; empty string when omitted)
//   - updatedAt: int (required, epoch milliseconds, > 0 and <= 4102444800000)
//
// Document: events/{eventId}/config/invite
// Parent Path Param:
//   - eventId: string (required, 1..80 chars) - Event identifier
// Fields (strictly allowed keys only; 'theme' and 'updatedAt' required, all
// other fields optional for backward compatibility with older cached browser
// tabs; admin-only writes validate core schema/enum/timestamp/large-payload
// bounds to stay well under Firestore's 1,000-expression evaluation limit;
// public presentation config & optional admin-published event contact details;
// no guest PII):
//   - mediaMode: string (optional, enum: 'video' | 'image')
//   - imageAnimation: string (optional, enum: 'wax-seal-open' | 'gate-split' | 'curtain-up' | 'ken-burns')
//   - coverImageDataUrl: string (optional, 0..300000 chars; empty string or 'data:image/...' compressed WebP/JPEG data URL)
//   - openImageDataUrl: string (optional, 0..260000 chars; empty string or 'data:image/...' compressed WebP/JPEG data URL)
//   - theme: string (required, enum: 'gold-dark' | 'emerald-light' | 'navy-gold')
//   - fontPreset: string (optional, enum: 'modern' | 'classic' | 'ceremonial' | 'editorial')
//   - textScale: string (optional, enum: 'sm' | 'md' | 'lg')
//   - textSizes: map (optional, exact keys only: coverBadge, openButtonText, slide1Heading, welcomeNote, slide2Heading, slide2ExtraNote, slide3Heading, slide3SuccessTitle, slide3SuccessNote; each int 8..28) - per-element font sizes in pixels
//   - overlayDarkness: int (optional, 20..90)
//   - videoUrl: string (optional, 0..500 chars)
//   - posterUrl: string (optional, 0..500 chars)
//   - openBgUrl: string (optional, 0..500 chars)
//   - videoSpeed: number (optional, 0.75..2.5)
//   - slideDurationSec: int (optional, 0..20; 0 means manual)
//   - slide1DurationSec: int (optional, 0..30; 0 means manual)
//   - slide2DurationSec: int (optional, 0..30; 0 means manual)
//   - openAnimDurationSec: number (optional, 0.8..3.0)
//   - panelPosition: string (optional, enum: 'top' | 'center' | 'bottom')
//   - panelOffsetY: int (optional, -15..15)
//   - panelScales: map (optional, exact keys only: cover, slide1, slide2, slide3; each int 75..115) - per-panel scale percentages
//   - cardStyle: string (optional, enum: 'solid' | 'glass' | 'minimal')
//   - textAlign: string (optional, enum: 'center' | 'left')
//   - showSeal: bool (optional)
//   - customSealDataUrl: string (optional, 0..120000 chars; empty string or 'data:image/...' compressed WebP/PNG data URL)
//   - sealSize: string (optional, enum: 'sm' | 'md' | 'lg')
//   - sealOffsetX: int (optional, -35..35)
//   - sealOffsetY: int (optional, -35..35)
//   - coverBadge: string (optional, 0..60 chars)
//   - openButtonText: string (optional, 0..60 chars)
//   - slide1Heading: string (optional, 0..80 chars)
//   - slide1BannerDataUrl: string (optional, 0..90000 chars; empty string or 'data:image/...' compressed WebP/JPEG data URL)
//   - welcomeNote: string (optional, 0..300 chars)
//   - slide2Heading: string (optional, 0..80 chars)
//   - slide2ExtraNote: string (optional, 0..240 chars)
//   - dresscode: string (optional, 0..120 chars)
//   - mapsUrl: string (optional, 0..500 chars)
//   - showCountdown: bool (optional)
//   - showCalendarButton: bool (optional)
//   - slide3Heading: string (optional, 0..80 chars)
//   - slide3SuccessTitle: string (optional, 0..80 chars)
//   - slide3SuccessNote: string (optional, 0..240 chars)
//   - contactName: string (optional, 0..80 chars)
//   - contactPhone: string (optional, 0..30 chars)
//   - eventName: string (optional, 0..160 chars) - Event title for short links
//   - eventDate: string (optional, 0..80 chars) - Event date text for short links
//   - eventTime: string (optional, 0..80 chars) - Event time text for short links
//   - eventLocation: string (optional, 0..200 chars) - Event venue for short links
//   - eventOrganizer: string (optional, 0..160 chars) - Event organizer for short links
//   - updatedAt: int (required, epoch milliseconds, > 0 and <= 4102444800000)
//
// Collection: events/{eventId}/invites
// Parent Path Param:
//   - eventId: string (required, 1..80 chars) - Event identifier
// Document ID: {invitationCode}
//   - invitationCode: string (required, 1..40 chars) - Unique invitation code
// Fields (strictly required, exact keys only; per-code guest invitation card
// for short interactive invite links `/v/{eventId}/{invitationCode}`; no email,
// phone, or address PII):
//   - code: string (required, 1..40 chars, must equal {invitationCode} doc ID)
//   - salutation: string (required, 0..60 chars)
//   - recipientName: string (required, 1..120 chars)
//   - institution: string (required, 0..160 chars)
//   - updatedAt: int (required, epoch milliseconds, > 0 and <= 4102444800000)
//
// Access Model Notes:
//   - Guests access their own RSVP via an unauthenticated QR link containing
//     eventId + invitationCode (allows single-doc get, create, and update with
//     strict schema/type/size validation).
//   - Guests opening an interactive invite link (`?invite=1&eid=...` or
//     `/v/{eventId}/{invitationCode}`) can perform a single-doc `get` on
//     `events/{eventId}/config/invite` to load published visual theme, texts,
//     event metadata, and media URLs (no guest PII).
//   - Guests holding their unique short link `/v/{eventId}/{invitationCode}`
//     can perform a single-doc `get` on `events/{eventId}/invites/{invitationCode}`
//     to read ONLY their own invitation card. Listing `invites` is strictly
//     denied (`allow list: if false;`) so guests cannot browse other guests.
//   - Admin Studio `list` queries on RSVPs (`where('updatedAt', '>', lastSyncAt)`,
//     `orderBy('updatedAt', 'asc')`, `limit(<= 500)`) and writes to
//     `events/{eventId}/config/invite` and `events/{eventId}/invites/{invitationCode}`
//     require Firebase Auth with a verified email on the explicit admin
//     allowlist (`isAllowedAdmin()`).
//   - Deletes are strictly denied. All other collections and subcollections are
//     denied by default.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated Firebase Auth user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user has a verified email on the admin allowlist
    function isAllowedAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'aldilesaldo@gmail.com',
          'aldoaldiles@gmail.com'
        ];
    }

    // Validate that the document contains all required fields
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only allowed fields (no schema pollution)
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that a string field exists and falls within [minLen, maxLen]
    function validStringLength(data, field, minLen, maxLen) {
      return data[field] is string &&
        data[field].size() >= minLen &&
        data[field].size() <= maxLen;
    }

    // Validate that immutable fields are not modified on update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate path parameter lengths
    function isValidEventId(eventId) {
      return eventId is string && eventId.size() >= 1 && eventId.size() <= 80;
    }

    function isValidInvitationCode(invitationCode) {
      return invitationCode is string &&
        invitationCode.size() >= 1 &&
        invitationCode.size() <= 40;
    }

    // ===============================================================
    // Domain Validators (MUST be called in both create and update)
    // ===============================================================

    function rsvpFields() {
      return ['invitationCode', 'status', 'representative', 'note', 'updatedAt'];
    }

    function isValidRsvpStatus(status) {
      return status is string &&
        status in ['attending', 'represented', 'declined'];
    }

    function isValidRsvp(data, invitationCode) {
      return hasRequiredFields(rsvpFields()) &&
        hasOnlyAllowedFields(rsvpFields()) &&
        validStringLength(data, 'invitationCode', 1, 40) &&
        data.invitationCode == invitationCode &&
        isValidRsvpStatus(data.status) &&
        validStringLength(data, 'representative', 0, 120) &&
        validStringLength(data, 'note', 0, 240) &&
        data.updatedAt is int &&
        data.updatedAt > 0 &&
        data.updatedAt <= 4102444800000;
    }

    function inviteConfigFields() {
      return [
        'mediaMode',
        'imageAnimation',
        'coverImageDataUrl',
        'openImageDataUrl',
        'theme',
        'fontPreset',
        'textScale',
        'textSizes',
        'overlayDarkness',
        'videoUrl',
        'posterUrl',
        'openBgUrl',
        'videoSpeed',
        'slideDurationSec',
        'slide1DurationSec',
        'slide2DurationSec',
        'openAnimDurationSec',
        'panelPosition',
        'panelOffsetY',
        'panelScales',
        'cardStyle',
        'textAlign',
        'showSeal',
        'customSealDataUrl',
        'sealSize',
        'sealOffsetX',
        'sealOffsetY',
        'coverBadge',
        'openButtonText',
        'slide1Heading',
        'slide1BannerDataUrl',
        'welcomeNote',
        'slide2Heading',
        'slide2ExtraNote',
        'dresscode',
        'mapsUrl',
        'showCountdown',
        'showCalendarButton',
        'slide3Heading',
        'slide3SuccessTitle',
        'slide3SuccessNote',
        'contactName',
        'contactPhone',
        'eventName',
        'eventDate',
        'eventTime',
        'eventLocation',
        'eventOrganizer',
        'updatedAt'
      ];
    }

    // Keep expression count well under Firestore's 1,000-expression limit.
    // Writes are restricted to verified allowlisted admins (`isAllowedAdmin()`).
    function isValidInviteConfig(data) {
      return hasRequiredFields(['theme', 'updatedAt']) &&
        hasOnlyAllowedFields(inviteConfigFields()) &&
        data.theme is string &&
        data.theme in ['gold-dark', 'emerald-light', 'navy-gold'] &&
        data.updatedAt is int &&
        data.updatedAt > 0 &&
        data.updatedAt <= 4102444800000 &&
        (!('mediaMode' in data) || (data.mediaMode is string && data.mediaMode in ['video', 'image'])) &&
        (!('coverImageDataUrl' in data) || (data.coverImageDataUrl is string && data.coverImageDataUrl.size() <= 300000)) &&
        (!('openImageDataUrl' in data) || (data.openImageDataUrl is string && data.openImageDataUrl.size() <= 260000)) &&
        (!('customSealDataUrl' in data) || (data.customSealDataUrl is string && data.customSealDataUrl.size() <= 120000)) &&
        (!('slide1BannerDataUrl' in data) || (data.slide1BannerDataUrl is string && data.slide1BannerDataUrl.size() <= 90000)) &&
        (!('textSizes' in data) || (data.textSizes is map && data.textSizes.size() <= 12)) &&
        (!('panelScales' in data) || (data.panelScales is map && data.panelScales.size() <= 6)) &&
        (!('eventName' in data) || (data.eventName is string && data.eventName.size() <= 160)) &&
        (!('eventDate' in data) || (data.eventDate is string && data.eventDate.size() <= 80)) &&
        (!('eventTime' in data) || (data.eventTime is string && data.eventTime.size() <= 80)) &&
        (!('eventLocation' in data) || (data.eventLocation is string && data.eventLocation.size() <= 200)) &&
        (!('eventOrganizer' in data) || (data.eventOrganizer is string && data.eventOrganizer.size() <= 160));
    }

    function guestInviteFields() {
      return ['code', 'salutation', 'recipientName', 'institution', 'updatedAt'];
    }

    function isValidGuestInvite(data, invitationCode) {
      return hasRequiredFields(guestInviteFields()) &&
        hasOnlyAllowedFields(guestInviteFields()) &&
        data.code is string &&
        data.code == invitationCode &&
        data.salutation is string &&
        data.salutation.size() <= 60 &&
        data.recipientName is string &&
        data.recipientName.size() >= 1 &&
        data.recipientName.size() <= 120 &&
        data.institution is string &&
        data.institution.size() <= 160 &&
        data.updatedAt is int &&
        data.updatedAt > 0 &&
        data.updatedAt <= 4102444800000;
    }

    // ===============================================================
    // Default Deny
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Thin RSVP Subcollection: events/{eventId}/rsvps/{invitationCode}
    // ===============================================================

    match /events/{eventId}/rsvps/{invitationCode} {
      // Guests with a direct QR link (eventId + invitationCode) can fetch
      // their own RSVP document.
      allow get: if isValidEventId(eventId) &&
        isValidInvitationCode(invitationCode);

      // Admin Studio incremental sync query:
      //   query(collection(db, 'events', eventId, 'rsvps'),
      //         where('updatedAt', '>', lastSyncAt),
      //         orderBy('updatedAt', 'asc'),
      //         limit(500))
      // Restricted to verified allowlisted admin accounts with a bounded limit.
      allow list: if isAllowedAdmin() &&
        isValidEventId(eventId) &&
        request.query.limit is int &&
        request.query.limit > 0 &&
        request.query.limit <= 500;

      // Guests can create their RSVP only when all strict schema, type, enum,
      // size, and path-binding validations pass.
      allow create: if isValidEventId(eventId) &&
        isValidInvitationCode(invitationCode) &&
        isValidRsvp(request.resource.data, invitationCode);

      // Guests can update their RSVP only when all validations pass and
      // `invitationCode` remains immutable.
      allow update: if isValidEventId(eventId) &&
        isValidInvitationCode(invitationCode) &&
        isValidRsvp(request.resource.data, invitationCode) &&
        areImmutableFieldsUnchanged(['invitationCode']);

      // RSVP records are never deleted from client apps.
      allow delete: if false;
    }

    // ===============================================================
    // Interactive Invite Config Document: events/{eventId}/config/invite
    // ===============================================================

    match /events/{eventId}/config/invite {
      // Public single-document read so guests opening `?invite=1&eid=...`
      // can load the event's published theme, texts, and media URLs (no PII).
      allow get: if isValidEventId(eventId);

      // Listing config documents is strictly denied.
      allow list: if false;

      // Only verified allowlisted admins can create or update the invite
      // presentation config, subject to strict schema/type/range validation.
      allow create, update: if isAllowedAdmin() &&
        isValidEventId(eventId) &&
        isValidInviteConfig(request.resource.data);

      // Invite config documents are never deleted from client apps.
      allow delete: if false;
    }

    // ===============================================================
    // Per-Code Guest Invite Cards: events/{eventId}/invites/{invitationCode}
    // ===============================================================

    match /events/{eventId}/invites/{invitationCode} {
      // A guest holding their unique short link (`/v/{eventId}/{invitationCode}`)
      // can read ONLY their own invitation card.
      allow get: if isValidEventId(eventId) &&
        isValidInvitationCode(invitationCode);

      // STRICTLY DENY listing so no guest can enumerate or browse other guests.
      allow list: if false;

      // Only verified allowlisted admins can publish or update guest invite cards,
      // subject to strict schema, type, size, and path-binding validation.
      allow create, update: if isAllowedAdmin() &&
        isValidEventId(eventId) &&
        isValidInvitationCode(invitationCode) &&
        isValidGuestInvite(request.resource.data, invitationCode);

      // Guest invite card documents are never deleted from client apps.
      allow delete: if false;
    }
  }
}
